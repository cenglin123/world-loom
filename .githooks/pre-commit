#!/usr/bin/env bash
set -e
# novel_world_one — pre-commit hook
# 任务: (1) AGENTS.md 同步 (2) 伏笔表格式

# —— 1. AGENTS.md / CLAUDE.md / GEMINI.md 同步 ——
python scripts/agent_links.py check || {
    echo ""
    echo "============================================"
    echo "AGENTS.md / CLAUDE.md / GEMINI.md 内容不一致。"
    echo "正确流程：仅编辑 AGENTS.md，然后运行:"
    echo "  python scripts/agent_links.py repair"
    echo "============================================"
    exit 1
}

# —— 2. 伏笔登记表格式完整性 ——
STAGED=$(git diff --cached --name-only)
if echo "$STAGED" | grep -qF "04_伏笔/伏笔登记表.md"; then
    python scripts/check_foreshadowing.py || {
        echo ""
        echo "============================================"
        echo "伏笔登记表格式异常，请修正后重新提交。"
        echo "============================================"
        exit 1
    }
    echo "[pre-commit] foreshadowing table ok"
fi

echo "[pre-commit] all checks passed"
exit 0
