#!/usr/bin/env bash
set -e
# novel_world_one — commit-msg hook
# 治理文档修改保护：若提交触达治理文档，commit message 必须含 [governance] 标记

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# 本清单是治理文件的唯一权威来源——新增治理文件只改这一处。
# 内容层文件与其 _模板/ 下的骨架成对保护（改哪一份都要标记）。
GOVERNANCE_FILES=(
    "AGENTS.md"
    "_分发/AGENTS.md"
    "_分发/README.md"
    ".githooks/pre-commit"
    ".githooks/commit-msg"
    ".githooks/pre-push"
    "scripts/layers.py"
    "scripts/publish.py"
    "00_世界观/核心设定.md"
    "docs/audit-checklist.md"
    "docs/style-locked.md"
    "docs/writing-style.md"
    "05_复盘/reviewer-protocol.md"
    "05_复盘/reviewer-prompt-template.md"
    "05_复盘/maintenance-executor.md"
    "06_文风样本/README.md"
    "_模板/06_文风样本/README.md"
    "scripts/check_maintenance.py"
    "_模板/05_复盘/maintenance-executor.md"
    "_模板/00_世界观/核心设定.md"
    "_模板/docs/style-locked.md"
    "_模板/05_复盘/reviewer-protocol.md"
    "_模板/05_复盘/reviewer-prompt-template.md"
    "_模板/README.md"
)

STAGED=$(git -c core.quotepath=false diff --cached --name-only)
GOVERNANCE_TOUCHED=""
for gf in "${GOVERNANCE_FILES[@]}"; do
    if echo "$STAGED" | grep -qF "$gf"; then
        GOVERNANCE_TOUCHED="$GOVERNANCE_TOUCHED  $gf"
    fi
done

if [ -n "$GOVERNANCE_TOUCHED" ]; then
    if ! echo "$COMMIT_MSG" | grep -q "\[governance\]"; then
        echo ""
        echo "============================================"
        echo "[GOVERNANCE] 以下治理文档被修改:"
        echo "$GOVERNANCE_TOUCHED"
        echo ""
        echo "治理文档的修改必须标记，在 commit message 中加入 [governance]："
        echo "  git commit -m '[governance] 修改说明'"
        echo ""
        echo "原因：治理文档影响所有 agent 的行为基线，"
        echo "未标记的修改视为意外/未审查变更。"
        echo "============================================"
        exit 1
    fi
    echo "[commit-msg] governance ok (marked with [governance])"
fi

exit 0
